        <PackageReference Include="MongoDB.Driver.Core" Version="2.30.0" />
        <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.1" />
